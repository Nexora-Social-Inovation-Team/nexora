# Copy to .env at the REPO ROOT (this file's directory). Never commit .env.
# apps/api scripts load it with `bun --env-file=../../.env`.

# Neon pooled connection string (Prisma runtime)
DATABASE_URL=
# Neon direct connection string (used by prisma migrate)
DIRECT_URL=
# API port
PORT=3000
# Comma-separated allowed browser origins (web dev server, Expo web)
WEB_ORIGIN=http://localhost:5173,http://localhost:8081
# Secret used to sign the nexora_session cookie / bearer token
SESSION_SECRET=
# OpenAI-compatible chat base URL. Empty = HuggingFace router.
# A Colab vLLM tunnel goes here: https://<random>.trycloudflare.com/v1
# See docs/colab/trendyol-coach.ipynb.
HF_BASE_URL=
# Inference token (API process only, never in web/mobile/extension).
# With a self-served vLLM this is whatever --api-key the notebook printed.
HF_TOKEN=
# Chat model id served by a HuggingFace inference provider, e.g. Qwen/Qwen3-8B.
# No provider serves Trendyol-LLM today; see docs/ARCHITECTURE.md "LLM boundary".
HF_MODEL_ID=
