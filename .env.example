# Neon pooled connection string (Prisma runtime)
DATABASE_URL=
# Neon direct connection string (used by prisma migrate)
DIRECT_URL=
# HuggingFace Inference token (API process only, never in web/mobile/extension)
HF_TOKEN=
# Trendyol-LLM model id on HuggingFace
HF_MODEL_ID=
# Secret used to sign the nexora_session cookie / bearer token
SESSION_SECRET=
