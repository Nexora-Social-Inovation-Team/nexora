{
  "expo": {
    "name": "NEXORA",
    "slug": "nexora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nexora",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCFBF8",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030214"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030214"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
